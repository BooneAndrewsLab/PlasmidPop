{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/core/cloning/digest.ts",
    "src/core/cloning/ligate.ts",
    "src/core/cloning/pcr.ts",
    "src/core/cloning/mutagenesis.ts",
    "src/core/cloning/gibson.ts",
    "src/core/cloning/goldenGate.ts",
    "src/core/cloning/gateway.ts",
    "src/core/cloning/overlapPrimers.ts",
    "src/core/analysis/methylation.ts",
    "src/core/primers/anneal.ts",
    "src/core/primers/primerDesign.ts",
    "src/io/genbank/methylationComment.ts",
    "src/io/genbank/ownComments.ts",
    "src/io/fasta/fasta.ts",
    "src/core/diff/documentDiff.ts",
    "src/core/diff/removed.ts",
    "src/core/document/extract.ts",
    "src/core/history/history.ts",
    "src/core/lineage/lineage.ts",
    "src/core/lineage/record.ts",
    "src/core/lineage/describe.ts",
    "src/io/genbank/madeFromComment.ts",
    "src/io/fastq/fastq.ts",
    "src/io/share/link.ts",
    "src/storage/historyCodec.ts",
    "src/storage/historyFormat.ts",
    "src/core/primers/collection.ts",
    "src/core/annotate/detect.ts",
    "src/core/annotate/hits.ts",
    "src/core/annotate/library.ts",
    "src/io/ncbi/accession.ts",
    "src/io/ncbi/efetch.ts",
    "src/core/document/baseStyles.ts",
    "src/io/genbank/baseStylesComment.ts",
    "src/core/analysis/proteinProperties.ts",
    "src/core/analysis/openAsProtein.ts",
    "src/core/sequence/alphabet.ts",
    "src/core/document/tools.ts",
    "src/core/analysis/gel.ts",
    "src/core/analysis/codonUsage.ts",
    "src/core/cloning/fidelity.ts",
    "src/core/annotate/protein.ts",
    "src/io/snapgene/historyTree.ts",
    "src/app/keyBindings.ts",
    "src/core/alignment/scoring.ts"
  ],
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "timeoutMS": 30000,
  "concurrency": 8,
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": null
  },
  "ignorePatterns": [".venv-oracle", "dist", "coverage", "reports", "design", ".idea", ".claude"],
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "dryRunTimeoutMinutes": 20
}
